# Copy to .env. Used by both docker-compose.yml and docker-compose-prod.yaml.

# --- database ---------------------------------------------------------------
POSTGRES_USER=nailart
POSTGRES_DB=nailart
# Local dev may use anything; PRODUCTION REQUIRES a strong value (no default).
POSTGRES_PASSWORD=nailart

# --- local development ------------------------------------------------------
WEB_PORT=5173
API_PORT=8001
DB_PORT=5433
VITE_API_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- production (docker-compose-prod.yaml) ----------------------------------
WEB_DOMAIN=tailorfantasy.com
API_DOMAIN=api.tailorfantasy.com
# Required in production: Let's Encrypt sends expiry notices here.
ACME_EMAIL=

# --- contact form ------------------------------------------------------------
# Messages are always stored in Postgres; they are additionally emailed only
# when SMTP_HOST is set. Leave blank to store without forwarding.
CONTACT_RECIPIENT=support@talosy.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
