# Copy to .env and adjust. Values here are the defaults used by docker-compose.yml.

# Host connection string (scripts run outside Docker use this).
# Inside the container, docker-compose.yml overrides the host to `db`.
DATABASE_URL=postgresql+psycopg://nailart:nailart@localhost:5433/nailart

# Origins allowed to call this API from a browser, comma-separated.
# Vite falls back to 5174+ when 5173 is taken, so allow the usual range.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000

# Postgres container credentials
POSTGRES_USER=nailart
POSTGRES_PASSWORD=nailart
POSTGRES_DB=nailart

# Published host ports
API_PORT=8001
DB_PORT=5433

# --- contact form ------------------------------------------------------------
# Messages are always stored in Postgres; they are additionally emailed only
# when SMTP_HOST is set. Leave blank to store without forwarding.
CONTACT_RECIPIENT=support@talosy.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
